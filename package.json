{
    "name": "radius",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "engines": {
        "node": "22.x"
    },
    "scripts": {
        "build": "next build",
        "check": "next lint && tsc --noEmit",
        "db:generate": "drizzle-kit generate",
        "db:migrate": "drizzle-kit migrate",
        "db:push": "drizzle-kit push",
        "db:rls": "node scripts/apply-rls.mjs",
        "db:sync": "drizzle-kit push && node scripts/apply-rls.mjs",
        "db:studio": "drizzle-kit studio",
        "dev": "next dev",
        "images:recompress": "npx tsx scripts/recompress-images.ts",
        "og:generate": "npx tsx scripts/generate-og-images.ts",
        "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,mdx}\" --cache",
        "format:write": "prettier --write \"**/*.{ts,tsx,js,jsx,mdx}\" --cache",
        "lint": "run-s --continue-on-error lint:ts lint:typecheck",
        "lint:ts": "eslint '**/*.{js,ts,tsx}'",
        "lint:typecheck": "tsc --noEmit",
        "lint:fix": "npm run lint:ts -- --fix",
        "preview": "next build && next start",
        "start": "next start",
        "typecheck": "tsc --noEmit",
        "prepare": "husky"
    },
    "dependencies": {
        "@auth/core": "^0.41.3",
        "@auth/drizzle-adapter": "^1.7.2",
        "@dnd-kit/core": "^6.3.1",
        "@dnd-kit/sortable": "^10.0.0",
        "@dnd-kit/utilities": "^3.2.2",
        "@supabase/supabase-js": "^2.112.3",
        "@t3-oss/env-nextjs": "^0.12.0",
        "@tanstack/react-query": "^5.69.0",
        "@trpc/client": "^11.0.0",
        "@trpc/react-query": "^11.0.0",
        "@trpc/server": "^11.0.0",
        "dotenv": "^17.4.2",
        "drizzle-orm": "^0.45.4",
        "drizzle-zod": "^0.8.3",
        "libphonenumber-js": "^1.13.10",
        "next": "^15.2.3",
        "next-auth": "^5.0.0-beta.32",
        "next-themes": "^0.4.6",
        "postgres": "^3.4.4",
        "react": "^19.0.0",
        "react-dom": "^19.0.0",
        "react-phone-number-input": "^3.4.17",
        "server-only": "^0.0.1",
        "sharp": "^0.35.5",
        "superjson": "^2.2.1",
        "swiper": "^14.1.0",
        "yet-another-react-lightbox": "^3.32.2",
        "zod": "^3.24.2"
    },
    "devDependencies": {
        "@eslint/eslintrc": "^3.3.1",
        "@tailwindcss/postcss": "^4.0.15",
        "@types/node": "^20.19.41",
        "@types/react": "^19.0.0",
        "@types/react-dom": "^19.0.0",
        "drizzle-kit": "^0.31.11",
        "eslint": "^9.23.0",
        "eslint-config-next": "^15.2.3",
        "eslint-plugin-drizzle": "^0.2.3",
        "eslint-plugin-simple-import-sort": "^12.1.1",
        "eslint-plugin-unused-imports": "^4.4.1",
        "husky": "^9.1.7",
        "lint-staged": "^17.6.0",
        "npm-run-all2": "^9.0.3",
        "postcss": "^8.5.3",
        "prettier": "^3.5.3",
        "prettier-plugin-tailwindcss": "^0.6.11",
        "tailwindcss": "^4.0.15",
        "tsx": "^4.23.15",
        "typescript": "^5.8.2",
        "typescript-eslint": "^8.27.0"
    },
    "browserslist": {
        "production": [
            "chrome >= 100",
            "edge >= 100",
            "firefox >= 100",
            "safari >= 15.4"
        ],
        "development": [
            "last 1 chrome version",
            "last 1 firefox version",
            "last 1 safari version"
        ]
    },
    "ct3aMetadata": {
        "initVersion": "7.40.0"
    },
    "packageManager": "npm@10.9.3"
}
